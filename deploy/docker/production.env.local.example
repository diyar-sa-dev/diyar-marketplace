# DIYAR local production stack (same compose as KVM2 Hostinger).
# Copy to production.env:  Copy-Item deploy/docker/production.env.local.example deploy/docker/production.env
# NEVER commit production.env.
#
# Networking: fixed hostname — no LAN IP hunting. Run scripts/local/Ensure-DiyarHostsEntry.ps1 once (Admin).
# Open always: http://diyar.local:8080 (scripts/local/start-dev-gateway.ps1)

APP_ENV=local
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate
APP_TIMEZONE=Asia/Riyadh
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

# === Stable local URL (never changes when Wi‑Fi IP changes) ===
DIYAR_GATEWAY_HOST=diyar.local
DIYAR_LAN_HOST=diyar.local
GATEWAY_PORT=8080
HTTP_PORT=8093
FRONTEND_PORT=3000

FRONTEND_URL=http://diyar.local:8080
DIYAR_FRONTEND_URL=http://diyar.local:8080

SANCTUM_STATEFUL_DOMAINS_BASE=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000,diyar.local,diyar.local:8080
CORS_ALLOWED_ORIGINS_BASE=http://localhost:3000,http://127.0.0.1:3000,http://diyar.local:8080

# Synced by scripts/local/Sync-ProductionEnv.ps1
APP_URL=http://diyar.local:8080
REVERB_HOST=diyar.local
REVERB_PORT=8080
REVERB_SCHEME=http

SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

DB_DATABASE=diyar_production_local
DB_USERNAME=diyar
DB_PASSWORD=diyar_local_db_pass
MYSQL_ROOT_PASSWORD=diyar_local_root_pass

REDIS_PASSWORD=diyar_local_redis_pass
REDIS_PREFIX=diyar-prodlocal-

REVERB_APP_KEY=diyar_local_reverb_key
REVERB_APP_SECRET=diyar-reverb-secret
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_BROADCAST_HOST=nginx
REVERB_BROADCAST_PORT=80
REVERB_BROADCAST_SCHEME=http

MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@localhost
DIYAR_MAIL_ENABLED=false

# Payments — fake gateway for local Docker (no HTTPS required)
DIYAR_PAYMENT_GATEWAY=myfatoorah
DIYAR_PAYMENT_CURRENCY=SAR
DIYAR_PAYMENT_SESSION_EXPIRY_MINUTES=10
DIYAR_PAYMENT_USE_FAKE_GATEWAY=true

# Platform / demo (aligned with backend/.env local defaults)
DIYAR_DEMO_PASSWORD=Password123!
DIYAR_OTP_TEST_CODE=123456
DIYAR_SUPPORT_PHONE=+966500000000
DIYAR_SUPPORT_EMAIL=support@diyar.com
DIYAR_SUPPORT_HOURS=9:00 - 18:00
DIYAR_MEDIA_MAX_UPLOAD_KB=5120
DIYAR_LOYALTY_SAR_PER_POINT=50
DIYAR_CHAT_REALTIME=true

# AI design assistant
DIYAR_ASSISTANT_ENABLED=true
DIYAR_ASSISTANT_USE_FAKE=false
DIYAR_ASSISTANT_PROVIDER=google
GEMINI_API_KEY=
DIYAR_GEMINI_MODEL=gemini-2.5-flash-lite
DIYAR_GEMINI_TEMPERATURE=0.7
OPENAI_API_KEY=
DIYAR_OPENAI_MODEL=gpt-4o-mini

DIYAR_ENFORCE_REDIS_IN_PRODUCTION=true
