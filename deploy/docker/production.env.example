# DIYAR KVM2 production — copy to deploy/docker/production.env and fill secrets.
# NEVER commit production.env to git.

APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate

APP_URL=https://api.<DOMAIN>
FRONTEND_URL=https://app.<DOMAIN>
DIYAR_FRONTEND_URL=https://app.<DOMAIN>
SANCTUM_STATEFUL_DOMAINS=app.<DOMAIN>,www.<DOMAIN>,admin.<DOMAIN>

DB_DATABASE=diyar_production
DB_USERNAME=diyar
DB_PASSWORD=<DB_PASSWORD>
MYSQL_ROOT_PASSWORD=<MYSQL_ROOT_PASSWORD>

REDIS_PASSWORD=<REDIS_PASSWORD>
REDIS_PREFIX=diyar-production-

REVERB_APP_KEY=<REVERB_APP_KEY>
REVERB_APP_SECRET=<REVERB_APP_SECRET>
REVERB_HOST=realtime.<DOMAIN>
REVERB_PORT=443
REVERB_SCHEME=https

# Internal Docker publish path (app → nginx → reverb). Omit on single-host installs.
REVERB_BROADCAST_HOST=nginx
REVERB_BROADCAST_PORT=80
REVERB_BROADCAST_SCHEME=http

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=<GMAIL_ADDRESS>
MAIL_PASSWORD=<GMAIL_APP_PASSWORD>
MAIL_FROM_ADDRESS=noreply@<DOMAIN>
DIYAR_MAIL_ENABLED=true

DIYAR_PAYMENT_USE_FAKE_GATEWAY=false
MYFATOORAH_API_KEY=<MYFATOORAH_API_KEY>
MYFATOORAH_WEBHOOK_SECRET_KEY=<WEBHOOK_SECRET>

HTTP_PORT=8093
