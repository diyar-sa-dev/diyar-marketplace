# DIYAR KVM2-equivalent local validation — copy to kvm2-test.env (never commit kvm2-test.env)
# Usage: scripts/performance/run-kvm2-equivalent-validation.ps1

APP_ENV=local
APP_DEBUG=false
APP_KEY=base64:GENERATE_OR_COPY_FROM_local_production_env
APP_TIMEZONE=Asia/Riyadh
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

DIYAR_LAN_HOST=127.0.0.1
HTTP_PORT=8193
FRONTEND_PORT=3000

FRONTEND_URL=http://127.0.0.1:8193
DIYAR_FRONTEND_URL=http://127.0.0.1:8193
APP_URL=http://127.0.0.1:8193

SANCTUM_STATEFUL_DOMAINS_BASE=localhost,127.0.0.1,127.0.0.1:8193
CORS_ALLOWED_ORIGINS_BASE=http://127.0.0.1:8193,http://localhost:8193

SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

DB_DATABASE=diyar_kvm2_test
DB_USERNAME=diyar
DB_PASSWORD=kvm2_test_db_secret
MYSQL_ROOT_PASSWORD=kvm2_test_root_secret

REDIS_PASSWORD=kvm2_test_redis_secret
REDIS_PREFIX=diyar-kvm2-test-

REVERB_APP_KEY=kvm2_test_reverb_key
REVERB_APP_SECRET=kvm2_test_reverb_secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8193
REVERB_SCHEME=http
REVERB_BROADCAST_HOST=nginx
REVERB_BROADCAST_PORT=80
REVERB_BROADCAST_SCHEME=http

DIYAR_LOADTEST_MODE=false
DIYAR_ENFORCE_REDIS_IN_PRODUCTION=true
DIYAR_PAYMENT_USE_FAKE_GATEWAY=true
DIYAR_MAIL_ENABLED=false
MAIL_MAILER=log

DIYAR_DEMO_PASSWORD=Password123!
DIYAR_OTP_TEST_MODE=true
DIYAR_OTP_TEST_CODE=123456
DIYAR_SMS_DRIVER=log

OCTANE_WORKERS=2
LOG_LEVEL=warning

NGINX_CONF=./deploy/nginx/kvm2-docker-octane.conf

DIYAR_FEATURE_VISUAL_SEARCH_ENABLED=true
DIYAR_VISUAL_SEARCH_ENABLED=true
