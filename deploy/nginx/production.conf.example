# DIYAR production reverse proxy (Phase 28.13 example)
#
# Models:
#   - Marketplace SPA: diyar.com / www.diyar.com
#   - Admin SPA:       admin.diyar.com (same dist, separate host)
#   - API:             api.diyar.com
#   - WebSocket:       ws via Reverb/Pusher (adjust path)
#
# CDN optional: point DIYAR_CDN_ASSETS_URL to CDN origin; Nginx still serves fallback.

upstream diyar_api {
    server 127.0.0.1:8000;
    keepalive 32;
}

upstream diyar_reverb {
    server 127.0.0.1:8090;
}

# --- gzip (enable brotli module separately if available) ---
gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 5;
gzip_min_length 256;
gzip_types
    application/javascript
    application/json
    application/xml
    text/css
    text/javascript
    text/plain
    image/svg+xml;

map $sent_http_content_type $diyar_static_cache {
    default                                 "public, max-age=86400";
    "text/html"                               "no-cache";
    "application/javascript"                  "public, max-age=31536000, immutable";
    "text/css"                                "public, max-age=31536000, immutable";
    "image/svg+xml"                           "public, max-age=31536000, immutable";
    "font/woff2"                              "public, max-age=31536000, immutable";
}

server {
    listen 443 ssl http2;
    server_name api.diyar.com;

    ssl_certificate     /etc/letsencrypt/live/api.diyar.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.diyar.com/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    server_tokens off;

    # Block sensitive paths (defense in depth — app root should not be web-accessible)
    location ~ /\.(env|git|ht) {
        deny all;
        return 404;
    }

    location ~* \.(sql|bak|log|ini|sh)$ {
        deny all;
        return 404;
    }

    client_max_body_size 12m;

    location /app/ {
        proxy_pass http://diyar_reverb;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location /broadcasting {
        proxy_pass http://diyar_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Public media (product/vendor uploads) — long cache; URLs should be content-addressed or versioned
    location /storage/ {
        alias /var/www/diyar/backend/storage/app/public/;
        add_header Cache-Control "public, max-age=604800";
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }

    location / {
        proxy_pass http://diyar_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;

        # Respect Laravel ApplyHttpCachePolicy — do not override Cache-Control here
        proxy_buffering on;
    }
}

server {
    listen 443 ssl http2;
    server_name diyar.com www.diyar.com admin.diyar.com;

    root /var/www/diyar/frontend/dist;
    index index.html;

    ssl_certificate     /etc/letsencrypt/live/diyar.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/diyar.com/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    server_tokens off;

    location ~ /\.(env|git|ht) {
        deny all;
        return 404;
    }

    location ~* \.(sql|bak|log|ini|sh|php)$ {
        deny all;
        return 404;
    }

    # Reverb WebSocket (Pusher protocol lives at /app/{key})
    location /app/ {
        proxy_pass http://diyar_reverb;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location /broadcasting {
        proxy_pass http://diyar_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Hashed Vite assets — immutable long TTL
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }

    # Root static files (favicon, manifest, robots)
    location ~* \.(svg|png|webp|ico|txt|xml|webmanifest)$ {
        add_header Cache-Control "public, max-age=604800";
        try_files $uri =404;
    }

    # SPA shell — never immutable; enables safe post-deploy index refresh
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache, must-revalidate";
        try_files $uri $uri/ /index.html;
    }
}
