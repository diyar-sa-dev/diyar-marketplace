; DIYAR production OPcache (Phase 28.14)
; Install as /etc/php/8.2/fpm/conf.d/99-diyar-opcache.ini

[opcache]
opcache.enable=1
opcache.enable_cli=0
opcache.memory_consumption=192
opcache.interned_strings_buffer=16
opcache.max_accelerated_files=20000
opcache.validate_timestamps=0
opcache.revalidate_freq=0
opcache.save_comments=1
opcache.jit=0

; After deploy: reload PHP-FPM to pick up new bytecode (do not use timestamp validation in prod)
