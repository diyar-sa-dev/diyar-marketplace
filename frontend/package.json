{
  "name": "diyar-marketplace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:prod-api": "vite --mode prod-api --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/{api,lib,utils,hooks,types,admin,components/common,components/routes,components/coupon,components/services,components/checkout,routes,test}/**/*.{ts,tsx}\" \"src/pages/dashboard/VendorCoupons.tsx\" --max-warnings 0",
    "lint:fix": "eslint \"src/{api,lib,utils,hooks,types,admin,components/common,components/routes,components/coupon,components/services,components/checkout,routes,test}/**/*.{ts,tsx}\" \"src/pages/dashboard/VendorCoupons.tsx\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/{api,lib,utils,hooks,types,admin,components/common,components/routes,components/coupon,components/services,components/checkout,routes,test,pages/dashboard}/**/*.{ts,tsx}\" \"src/pages/dashboard/VendorCoupons.tsx\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.19.0",
    "laravel-echo": "^2.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pusher-js": "^8.6.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1",
    "sweetalert2": "^11.26.25"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^27.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.2.3",
    "vitest": "^3.2.7"
  }
}
