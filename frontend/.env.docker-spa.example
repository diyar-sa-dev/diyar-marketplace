# Built SPA served from diyar-production nginx (deploy/nginx/kvm2-docker-spa.conf)
# Copy to .env.docker-spa locally (gitignored), then: npm run build:docker-spa

VITE_API_URL=/api/v1
VITE_BACKEND_URL=
VITE_APP_NAME=DIYAR

VITE_REVERB_APP_KEY=diyar_local_reverb_key
VITE_REVERB_HOST=
VITE_REVERB_PORT=
VITE_REVERB_SCHEME=http

VITE_PLATFORM_SUPPORT_PHONE=+966500000000
VITE_PLATFORM_SUPPORT_EMAIL=support@diyar.com
VITE_PLATFORM_SUPPORT_HOURS=9:00 - 18:00

VITE_ROOM_DESIGNER_25D_ENABLED=true
VITE_ROOM_DESIGNER_3D_ENABLED=true
VITE_ROOM_DESIGNER_AI_SPATIAL_ENABLED=true
VITE_ROOM_DESIGNER_AR_ENABLED=false
