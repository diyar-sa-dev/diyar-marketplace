# Vercel production — Hostinger KVM2 API backend
#
# Set in Vercel Project → Settings → Environment Variables (Production)

VITE_API_URL=https://api.<DOMAIN>/api/v1
VITE_BACKEND_URL=https://api.<DOMAIN>

VITE_APP_NAME=DIYAR
VITE_ADMIN_PANEL_URL=/admin

# Realtime — must match backend REVERB_APP_KEY
VITE_REVERB_APP_KEY=<REVERB_APP_KEY>
VITE_REVERB_HOST=realtime.<DOMAIN>
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# Public support contact (optional)
VITE_PLATFORM_SUPPORT_PHONE=+966500000000
VITE_PLATFORM_SUPPORT_EMAIL=support@<DOMAIN>
