# Vercel production — copy into Vercel Project → Settings → Environment Variables
# Use SAME-ORIGIN URLs (Vercel proxies /api + /sanctum to Render — see frontend/vercel.json).
# Cross-origin direct Render URLs break Sanctum cookies (419 CSRF) in modern browsers.

VITE_API_URL=/api/v1
VITE_BACKEND_URL=

# If you skip Vercel proxy and call Render directly (not recommended):
# VITE_API_URL=https://diyar-k255.onrender.com/api/v1
# VITE_BACKEND_URL=https://diyar-k255.onrender.com

VITE_APP_NAME=DIYAR
VITE_ADMIN_PANEL_URL=/admin

VITE_PLATFORM_SUPPORT_PHONE=+966500000000
VITE_PLATFORM_SUPPORT_EMAIL=support@diyar.sa
VITE_PLATFORM_SUPPORT_HOURS=9:00 - 18:00

VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
