# Vercel production — temporary public landing page (no backend)
#
# Vercel project settings:
# - Root Directory: frontend
# - Build Command: npm run build:landing (also set in vercel.json)
# - Output Directory: dist
#
# Set in Vercel Project → Settings → Environment Variables (Production):
VITE_LANDING_MODE=true
VITE_SITE_URL=https://deyarhome.com
# When the full platform launches, remove VITE_LANDING_MODE and configure API URLs instead.
# VITE_API_URL=https://api.<DOMAIN>/api/v1
# VITE_BACKEND_URL=https://api.<DOMAIN>

VITE_APP_NAME=DIYAR

# Public support contact (optional — used by landing contact CTAs)
VITE_PLATFORM_SUPPORT_PHONE=+966500000000
VITE_PLATFORM_SUPPORT_EMAIL=support@deyarhome.com
