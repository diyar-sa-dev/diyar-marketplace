# Vercel production — copy values into Vercel Project → Settings → Environment Variables
# (Production). Do not commit secrets.

# Render API (cross-origin SPA — required for Sanctum CSRF + session cookies)
VITE_API_URL=https://diyar-api.onrender.com/api/v1
VITE_BACKEND_URL=https://diyar-api.onrender.com

# Future VPS / same-origin (Hostinger + Nginx reverse proxy): use relative URLs instead:
# VITE_API_URL=/api/v1
# VITE_BACKEND_URL=

VITE_APP_NAME=DIYAR
VITE_ADMIN_PANEL_URL=/admin

# Platform support (floating call button)
VITE_PLATFORM_SUPPORT_PHONE=+966500000000
VITE_PLATFORM_SUPPORT_EMAIL=support@diyar.sa
VITE_PLATFORM_SUPPORT_HOURS=9:00 - 18:00

# Realtime — leave empty until Reverb/WebSocket is deployed (optional for V1)
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
