# Vercel production — direct Render API (recommended; avoids Vercel proxy 408).
# Set matching Render env: SESSION_SAME_SITE=none, SANCTUM_STATEFUL_DOMAINS=diyar-psi.vercel.app
VITE_API_URL=https://diyar-k255.onrender.com/api/v1
VITE_BACKEND_URL=https://diyar-k255.onrender.com

# Optional same-origin proxy (vercel.json rewrites — can 408 when Render is cold):
# VITE_API_URL=/api/v1
# VITE_BACKEND_URL=
# VITE_USE_API_PROXY=true

VITE_APP_NAME=DIYAR
VITE_ADMIN_PANEL_URL=/admin

VITE_PLATFORM_SUPPORT_PHONE=+966500000000
VITE_PLATFORM_SUPPORT_EMAIL=support@diyar.sa
VITE_PLATFORM_SUPPORT_HOURS=9:00 - 18:00

VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
