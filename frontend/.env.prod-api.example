# Local production Docker stack — use scripts/local/start-frontend-prod-api.ps1
# (writes .env.prod-api.local with same-origin Vite proxy to http://<LAN-IP>:8093)

VITE_API_URL=/api/v1
VITE_BACKEND_URL=
VITE_APP_NAME=DIYAR

# Must match deploy/docker/production.env REVERB_APP_KEY
VITE_REVERB_APP_KEY=diyar_local_reverb_key
# Leave host/port empty — WebSocket goes through Vite /app/ proxy
VITE_REVERB_HOST=
VITE_REVERB_PORT=
VITE_REVERB_SCHEME=http

VITE_PLATFORM_SUPPORT_PHONE=+966500000000
VITE_PLATFORM_SUPPORT_EMAIL=support@diyar.com
VITE_PLATFORM_SUPPORT_HOURS=9:00 - 18:00
