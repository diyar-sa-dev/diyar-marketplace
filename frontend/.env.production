# Production / preview builds — same-origin API via reverse proxy or Vite preview proxy.
VITE_API_URL=/api/v1
VITE_BACKEND_URL=

# Realtime — VITE_REVERB_APP_KEY must equal backend REVERB_APP_KEY.
# Same-origin VPS: leave HOST empty (browser uses the page hostname + 443/wss).
VITE_REVERB_APP_KEY=diyar-local-key
VITE_REVERB_HOST=
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
VITE_SITE_URL=https://diyar.com
