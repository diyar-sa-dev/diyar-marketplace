# Frontend environment — copy to .env.local for local overrides

# Same-origin via Vite proxy (recommended local dev — fixes Sanctum CSRF cookies)
VITE_API_URL=/api/v1
VITE_BACKEND_URL=

# Production (Vercel) — see frontend/.env.production.example and deploy/RENDER_VERCEL.md
# VITE_API_URL=https://your-api.onrender.com/api/v1
# VITE_BACKEND_URL=https://your-api.onrender.com

# Display name
VITE_APP_NAME=DIYAR

# Optional CDN base for hashed production assets (Phase 28.13)
# VITE_CDN_BASE_URL=https://cdn.diyar.com

# Platform support (floating call button)
VITE_PLATFORM_SUPPORT_PHONE=+966500000000
VITE_PLATFORM_SUPPORT_EMAIL=support@diyar.com
VITE_PLATFORM_SUPPORT_HOURS=9:00 - 18:00

# Realtime — must match deploy/docker/production.env REVERB_APP_KEY
# Leave host/port empty for local dev (WebSocket uses Vite /app/ proxy → :8093)
VITE_REVERB_APP_KEY=diyar_local_reverb_key
VITE_REVERB_HOST=
VITE_REVERB_PORT=
VITE_REVERB_SCHEME=http
