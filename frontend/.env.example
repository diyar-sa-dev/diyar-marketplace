# Frontend environment — copy to .env.local for local overrides

# Same-origin via Vite proxy (recommended local dev — fixes Sanctum CSRF cookies)
VITE_API_URL=/api/v1
VITE_BACKEND_URL=

# Direct backend (only if NOT using Vite proxy — cross-origin, CSRF fragile)
# VITE_API_URL=http://localhost:8000/api/v1
# VITE_BACKEND_URL=http://localhost:8000

# Display name
VITE_APP_NAME=DIYAR
