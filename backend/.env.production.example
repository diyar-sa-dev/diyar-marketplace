# Render production — prod-temp branch (PostgreSQL)
# Set in Render Web Service → Environment. Generate APP_KEY: php artisan key:generate --show

APP_NAME=DIYAR
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://diyar-k255.onrender.com
APP_TIMEZONE=Asia/Riyadh

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Optional Supabase PostgreSQL instead of Render Postgres:
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Redis — Render Redis or Upstash (required in production)
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
# Use `none` when Vercel calls Render directly (cross-origin). Use `lax` only with Vercel /api proxy.
SESSION_SAME_SITE=none
# Leave empty — do NOT set to *.vercel.app while API is on Render.
SESSION_DOMAIN=

REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_PREFIX=diyar-production-

# VPS production — Vercel SPA + Hostinger KVM2 API
#
# Domains (replace <DOMAIN>):
#   app.<DOMAIN>      → Vercel (frontend)
#   api.<DOMAIN>      → KVM2 Nginx → PHP-FPM
#   realtime.<DOMAIN> → KVM2 Nginx → Reverb (WebSocket)
#
# Cross-origin Sanctum (HTTPS required):
FRONTEND_URL=https://app.<DOMAIN>
DIYAR_FRONTEND_URL=https://app.<DOMAIN>
SANCTUM_STATEFUL_DOMAINS=app.<DOMAIN>,www.<DOMAIN>,admin.<DOMAIN>
APP_URL=https://api.<DOMAIN>
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none
SESSION_DOMAIN=

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

# Reverb — REVERB_APP_KEY must equal frontend VITE_REVERB_APP_KEY
REVERB_APP_ID=diyar
REVERB_APP_KEY=diyar-reverb-key
REVERB_APP_SECRET=
REVERB_HOST=diyar-reverb.onrender.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_ALLOWED_ORIGINS="${FRONTEND_URL}"
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8090
# Same-origin VPS (Nginx proxies /app to Reverb on 8090):
# REVERB_HOST=127.0.0.1
# REVERB_PORT=8090
# REVERB_SCHEME=http
# REVERB_ALLOWED_ORIGINS=https://diyar.sa,https://www.diyar.sa

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@<DOMAIN>
MAIL_FROM_NAME="${APP_NAME}"
DIYAR_MAIL_ENABLED=true
DIYAR_MAIL_FAIL_SILENTLY=false

DIYAR_PAYMENT_USE_FAKE_GATEWAY=false
MYFATOORAH_TEST_MODE=false

# Comma-separated CIDRs trusted to set X-Forwarded-* (defaults to Docker private ranges)
# TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12
MYFATOORAH_API_KEY=
MYFATOORAH_COUNTRY_ISO=SAU
MYFATOORAH_WEBHOOK_SECRET_KEY=
MYFATOORAH_REDIRECT_URL=https://diyar.vercel.app

# Ops / performance (Render FREE)
DIYAR_ENFORCE_REDIS_IN_PRODUCTION=true
DIYAR_HEALTH_PROBE_CACHE_SECONDS=45
DIYAR_MIGRATE_ON_BOOT=false
DIYAR_SEED_ON_BOOT=false

# First deploy on Render FREE (no shell): set for ONE deploy, then disable.
# DIYAR_PROVISION_ON_BOOT=true   # migrate + seed (roles, categories, catalog, settings)
# DIYAR_MIGRATE_ON_BOOT=true     # migrate only
# DIYAR_SEED_ON_BOOT=true        # seed only (auto-runs migrate first)
DIYAR_CATEGORY_TREE_CACHE_SECONDS=900
DIYAR_SEARCH_FACETS_CACHE_SECONDS=300
DIYAR_SEARCH_SUGGESTIONS_CACHE_SECONDS=45
DIYAR_VENDOR_DASHBOARD_CACHE_SECONDS=90
DIYAR_ADMIN_DASHBOARD_CACHE_SECONDS=60
DIYAR_NOTIFICATIONS_UNREAD_CACHE_SECONDS=30
DB_CONNECT_TIMEOUT=5
OCTANE_WORKERS=2
OCTANE_TASK_WORKERS=1
API_RATE_LIMIT_PER_MINUTE=120

# Validate: php artisan diyar:validate-environment
