# Render production — set these in Render Web Service → Environment
# (or copy to backend/.env on VPS). Generate APP_KEY with: php artisan key:generate --show

APP_NAME=DIYAR
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://diyar-api.onrender.com
APP_TIMEZONE=Asia/Riyadh

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Render PostgreSQL is not supported — use Render MySQL or external MySQL (e.g. PlanetScale, Hostinger)
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Redis — Render Redis or Upstash (required in production)
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none
SESSION_DOMAIN=

REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_PREFIX=diyar-production-

# Vercel frontend origin (CORS + Sanctum) — hostname only, comma-separated, no https://
FRONTEND_URL=https://diyar.vercel.app
SANCTUM_STATEFUL_DOMAINS=diyar.vercel.app
DIYAR_FRONTEND_URL=https://diyar.vercel.app

# Future VPS same-domain example:
# APP_URL=https://api.diyar.sa
# FRONTEND_URL=https://diyar.sa
# SANCTUM_STATEFUL_DOMAINS=diyar.sa,www.diyar.sa,admin.diyar.sa
# SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_FROM_ADDRESS=noreply@diyar.sa
MAIL_FROM_NAME="${APP_NAME}"
DIYAR_MAIL_ENABLED=true
DIYAR_MAIL_FAIL_SILENTLY=true

# Payments — real gateway in production
DIYAR_PAYMENT_USE_FAKE_GATEWAY=false
MYFATOORAH_TEST_MODE=false
MYFATOORAH_API_KEY=
MYFATOORAH_COUNTRY_ISO=SAU
MYFATOORAH_WEBHOOK_SECRET_KEY=
MYFATOORAH_REDIRECT_URL=https://diyar.vercel.app

# Security / ops
DIYAR_ENFORCE_REDIS_IN_PRODUCTION=true
API_RATE_LIMIT_PER_MINUTE=120

# Do not seed demo data in production
# DIYAR_DEMO_PASSWORD=

# Validate before go-live:
# php artisan diyar:validate-environment
