# DIYAR — Local VPS Production Simulation Environment Template
# Replicates Hostinger KVM 2 production topology and constraints locally without touching real VPS.
# Usage:
#   Copy to backend/.env.vps-simulation and customize if necessary.
#   Never point this configuration to live production infrastructure or credentials.

APP_NAME=DIYAR
APP_ENV=production
APP_KEY=base64:2fl+KtvkblFZiGZtacP1ZAwJfvyIZxSzUI/qpgQHoW0=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Riyadh

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Database: Dedicated isolated local simulation database (MariaDB 10.4 / MySQL 8.0)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=diyar_vps_simulation
DB_USERNAME=root
DB_PASSWORD=

# Redis: Cache, Queues, Sessions, Locks, Realtime
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_DOMAIN=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_PREFIX=diyar_vps_sim_

# Frontend URL & Cross-Origin Sanctum
FRONTEND_URL=http://localhost:3000
DIYAR_FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:8080,localhost:8092,diyar.local,diyar.local:8080,127.0.0.1,127.0.0.1:3000,127.0.0.1:8000,127.0.0.1:8080,127.0.0.1:8092
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8092,http://diyar.local:8080,http://127.0.0.1:3000,http://127.0.0.1:8080,http://127.0.0.1:8092

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

# Reverb WebSockets
REVERB_APP_ID=diyar
REVERB_APP_KEY=diyar-local-key
REVERB_APP_SECRET=diyar-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8090
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8090
REVERB_BROADCAST_HOST=127.0.0.1
REVERB_BROADCAST_PORT=8090
REVERB_BROADCAST_SCHEME=http
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1,diyar.local

# Mail (Log sink for local simulation)
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@diyar.local
MAIL_FROM_NAME=DIYAR
DIYAR_MAIL_ENABLED=false
DIYAR_MAIL_FAIL_SILENTLY=true

# Operational constraints & Mock gateways (Never call real external APIs)
DIYAR_PAYMENT_GATEWAY=myfatoorah
DIYAR_PAYMENT_CURRENCY=SAR
DIYAR_PAYMENT_SESSION_EXPIRY_MINUTES=10
DIYAR_PAYMENT_USE_FAKE_GATEWAY=true
DIYAR_ENFORCE_REDIS_IN_PRODUCTION=true
API_RATE_LIMIT_PER_MINUTE=120
DIYAR_LOADTEST_MODE=false
DIYAR_VPS_SIMULATION=true

# SMS & OTP Mocks
DIYAR_SMS_DRIVER=log
DIYAR_OTP_TEST_MODE=true
DIYAR_OTP_TEST_CODE=123456
DIYAR_DEMO_PASSWORD=Password123!

# AI Assistant Mock
DIYAR_ASSISTANT_ENABLED=true
DIYAR_ASSISTANT_USE_FAKE=true

# Stage 30 — Room Designer Flags
DIYAR_FEATURE_ROOM_DESIGNER_ENABLED=true
DIYAR_FEATURE_ROOM_DESIGNER_25D_ENABLED=true
DIYAR_FEATURE_ROOM_DESIGNER_3D_ENABLED=true
DIYAR_FEATURE_VISUAL_SEARCH_ENABLED=true
