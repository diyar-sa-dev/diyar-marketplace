APP_NAME=DIYAR
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Riyadh

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 — primary database for V1 (sqlite acceptable for quick local scaffold)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=diyar
DB_USERNAME=root
DB_PASSWORD=

# Uncomment for sqlite-only local dev without MySQL:
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production: SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# Production / staging: Redis for cache + queues (database drivers remain available as fallback)
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@diyar.sa"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=me-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# DIYAR — Frontend SPA (CORS + Sanctum stateful domains)
# Must match the Origin header your SPA (or Postman frontend_origin) sends.
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000,localhost:5173,127.0.0.1:5173

# DIYAR — API metadata (health endpoint)
DIYAR_API_VERSION=1.0.0-stage8
DIYAR_STAGE="Stage 8 — Payments"

# DIYAR — OTP
DIYAR_OTP_LENGTH=6
DIYAR_OTP_EXPIRES_MINUTES=10
DIYAR_OTP_MAX_ATTEMPTS=5
DIYAR_OTP_MAX_RESENDS=5
DIYAR_OTP_RESEND_COOLDOWN=60
DIYAR_OTP_RATE_LIMIT=10

# DIYAR — Authentication rate limits
DIYAR_AUTH_RATE_LIMIT=20
DIYAR_OTP_RATE_LIMIT=10
DIYAR_CATALOG_SEARCH_RATE_LIMIT=60
DIYAR_CATALOG_SEARCH_SUGGESTIONS_RATE_LIMIT=90
DIYAR_WEBHOOKS_RATE_LIMIT=120
DIYAR_LOGIN_MAX_ATTEMPTS=5
DIYAR_LOGIN_DECAY_MINUTES=15

# Local/staging demo seed password (never use in production)
DIYAR_DEMO_PASSWORD=Password123!

# DIYAR media uploads (profile avatar — Stage 3)
DIYAR_MEDIA_DISK=media
DIYAR_MEDIA_MAX_UPLOAD_KB=5120

# MSEGAT SMS 
MSEGAT_USERNAME=
MSEGAT_API_KEY=
MSEGAT_SENDER_ID=
MSEGAT_LANG=Ar
MSEGAT_BASE_URL=https://www.msegat.com/gw

# API rate limiting (requests per minute per IP / user)
API_RATE_LIMIT_PER_MINUTE=60

# DIYAR — Payments 
DIYAR_PAYMENT_GATEWAY=myfatoorah
DIYAR_PAYMENT_CURRENCY=SAR
DIYAR_PAYMENT_SESSION_EXPIRY_MINUTES=10
# Local dev: true = simulated gateway with success/fail/expired. false = real MyFatoorah (needs HTTPS redirect).
DIYAR_PAYMENT_USE_FAKE_GATEWAY=
DIYAR_PAYMENT_PROVIDER=fake
DIYAR_FAKE_PAYMENT_SCENARIO=success
DIYAR_PAYMENT_WEBHOOK_ASYNC=true

# DIYAR — Finance (Stage 9)
DIYAR_FINANCE_CURRENCY=SAR
DIYAR_ESCROW_RELEASE_TRIGGER=vendor_order_delivered
DIYAR_PAYOUT_MINIMUM=100.00

# MyFatoorah 
MYFATOORAH_API_KEY=
MYFATOORAH_TEST_MODE=true
MYFATOORAH_COUNTRY_ISO=SAU
MYFATOORAH_WEBHOOK_SECRET_KEY=
MYFATOORAH_SAVE_CARD=false
MYFATOORAH_REGISTER_APPLE_PAY=false
# HTTPS public URL for MyFatoorah return callback (required for real gateway — use ngrok locally)
MYFATOORAH_REDIRECT_URL=


DIYAR_MAIL_ENABLED=
DIYAR_MAIL_FAIL_SILENTLY=true
DIYAR_MAIL_HOST=smtp.gmail.com
DIYAR_MAIL_PORT=587
DIYAR_MAIL_USERNAME=
DIYAR_MAIL_PASSWORD=
DIYAR_MAIL_ENCRYPTION=tls
DIYAR_MAIL_FROM_ADDRESS=
DIYAR_MAIL_FROM_NAME=Diyar
DIYAR_FRONTEND_URL=http://localhost:3000

# Platform support & AI assistant
DIYAR_SUPPORT_PHONE=+966500000000
DIYAR_SUPPORT_EMAIL=support@diyar.com
DIYAR_SUPPORT_HOURS="9:00 - 18:00"
DIYAR_ASSISTANT_ENABLED=true
DIYAR_OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
DIYAR_ASSISTANT_MAX_TOKENS=700
DIYAR_ASSISTANT_VERIFY_SSL=true

# Chat (Stage 17 / 17.5)
DIYAR_CHAT_REALTIME=true
DIYAR_CHAT_CACHE_PREFIX=diyar:chat:
DIYAR_CHAT_UNREAD_CACHE_TTL=300
DIYAR_CHAT_SUMMARY_CACHE_TTL=120
DIYAR_CHAT_TYPING_TTL=5
DIYAR_CHAT_TYPING_DEBOUNCE_MS=1500
DIYAR_CHAT_MESSAGES_PER_MINUTE=30
DIYAR_CHAT_CONVERSATIONS_PER_MINUTE=10
DIYAR_CHAT_TYPING_PER_MINUTE=60
DIYAR_CHAT_ATTACHMENTS_PER_MINUTE=10
CHAT_ACTIVE_MESSAGE_DAYS=90
CHAT_ARCHIVE_AFTER_DAYS=5
CHAT_ARCHIVE_ENABLED=false
DIYAR_CHAT_PRESENCE_TTL=120
DIYAR_CHAT_SUPPRESS_NOTIFICATIONS_WHEN_ACTIVE=true
# Backward-compatible alias; ignored when DIYAR_CHAT_SUPPRESS_NOTIFICATIONS_WHEN_ACTIVE is set.
DIYAR_CHAT_SUPPRESS_EMAIL_WHEN_ACTIVE=true
CHAT_PURGE_AFTER_ARCHIVE=false
CHAT_PURGE_REQUIRES_SAFE_TO_PURGE=true
CHAT_AUTO_MARK_SAFE_TO_PURGE=false
CHAT_ARCHIVE_BATCH_SIZE=200
CHAT_ARCHIVE_DISK=local
DIYAR_CHAT_ARCHIVE_QUEUE=chat-low

# Notification outbox (Stage 26.6) — transactional enqueue for external delivery
DIYAR_OUTBOX_ENABLED=true

# Reverb / Echo (shared with notifications)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8090
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS="${FRONTEND_URL}"
REVERB_APP_RATE_LIMITING_ENABLED=false
REVERB_SCALING_ENABLED=false
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Affiliate / referral commerce
DIYAR_AFFILIATE_MIN_COMMISSION_PERCENT=1
DIYAR_AFFILIATE_MAX_COMMISSION_PERCENT=30
DIYAR_AFFILIATE_ATTRIBUTION_DAYS=30
DIYAR_AFFILIATE_PAYOUT_MINIMUM=100.00
DIYAR_AFFILIATE_CURRENCY=SAR
DIYAR_AFFILIATE_CLICK_RATE_LIMIT=30
DIYAR_AFFILIATE_LINK_RATE_LIMIT=20
DIYAR_AFFILIATE_CLICK_DEDUPE_MINUTES=60
DIYAR_AFFILIATE_RESOLVE_RATE_LIMIT=30
DIYAR_AFFILIATE_DASHBOARD_CACHE_SECONDS=120
DIYAR_AFFILIATE_COMMISSION_AVAILABLE_ON=vendor_order_delivered

# Loyalty points (1 point per N SAR spent)
DIYAR_LOYALTY_SAR_PER_POINT=50

# Production infrastructure (fail boot if redis not configured)
DIYAR_ENFORCE_REDIS_IN_PRODUCTION=true

# ---------------------------------------------------------------------------
# Staging (APP_ENV=staging) — see backend/.env.staging.example
# ---------------------------------------------------------------------------
# APP_URL=https://staging-api.diyar.sa
# FRONTEND_URL=https://staging.diyar.sa
# DB_DATABASE=diyar_staging
# REDIS_PREFIX=diyar-staging-
# AWS_BUCKET=diyar-staging-media
# MYFATOORAH_TEST_MODE=true
# MAIL_FROM_NAME="[STAGING] DIYAR"

# ---------------------------------------------------------------------------
# Analytics (Phase 26.11)
# ---------------------------------------------------------------------------
DIYAR_ANALYTICS_EVENTS_ENABLED=true
DIYAR_ANALYTICS_VIEW_DEDUPE_SECONDS=1800
DIYAR_ANALYTICS_CHECKOUT_DEDUPE_SECONDS=3600
DIYAR_ANALYTICS_CACHE_KPI_SECONDS=60
DIYAR_ANALYTICS_CACHE_CHART_SECONDS=180
DIYAR_ANALYTICS_CACHE_PLATFORM_SECONDS=180
DIYAR_ANALYTICS_CACHE_FUNNEL_SECONDS=300
DIYAR_ANALYTICS_CACHE_COHORT_SECONDS=900
DIYAR_ANALYTICS_CACHE_SEARCH_SECONDS=300

# ---------------------------------------------------------------------------
# Production (APP_ENV=production) — see backend/.env.production.example
# Vercel frontend + Render API: deploy/RENDER_VERCEL.md
# ---------------------------------------------------------------------------
# APP_DEBUG=false
# SESSION_SECURE_COOKIE=true
# DB_DATABASE=diyar_production
# REDIS_PREFIX=diyar-production-
# DIYAR_PAYMENT_USE_FAKE_GATEWAY=false
# MYFATOORAH_TEST_MODE=false
# Validate: php artisan diyar:validate-environment