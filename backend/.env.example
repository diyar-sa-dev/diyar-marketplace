APP_NAME=DIYAR
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Riyadh

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 — primary database for V1 (sqlite acceptable for quick local scaffold)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=diyar
DB_USERNAME=root
DB_PASSWORD=

# Uncomment for sqlite-only local dev without MySQL:
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@diyar.sa"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=me-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# DIYAR — Frontend SPA (CORS + Sanctum stateful domains)
# Must match the Origin header your SPA (or Postman frontend_origin) sends.
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000,localhost:5173,127.0.0.1:5173

# DIYAR — API metadata (health endpoint)
DIYAR_API_VERSION=1.0.0-stage3
DIYAR_STAGE="Stage 3 — User Profile & Media"

# DIYAR — OTP
DIYAR_OTP_LENGTH=6
DIYAR_OTP_EXPIRES_MINUTES=10
DIYAR_OTP_MAX_ATTEMPTS=5
DIYAR_OTP_MAX_RESENDS=5
DIYAR_OTP_RESEND_COOLDOWN=60
DIYAR_OTP_RATE_LIMIT=10

# DIYAR — Authentication rate limits
DIYAR_AUTH_RATE_LIMIT=20
DIYAR_LOGIN_MAX_ATTEMPTS=5
DIYAR_LOGIN_DECAY_MINUTES=15

# DIYAR media uploads (profile avatar — Stage 3)
DIYAR_MEDIA_DISK=media
DIYAR_MEDIA_MAX_UPLOAD_KB=5120

# MSEGAT SMS 
MSEGAT_USERNAME=
MSEGAT_API_KEY=
MSEGAT_SENDER_ID=
MSEGAT_LANG=Ar
MSEGAT_BASE_URL=https://www.msegat.com/gw

# API rate limiting (requests per minute per IP / user)
API_RATE_LIMIT_PER_MINUTE=60
