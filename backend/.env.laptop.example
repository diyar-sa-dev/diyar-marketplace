APP_NAME=DIYAR
APP_ENV=local
APP_KEY=base64:1BvPDVyG+ycJGrAZ8/LIHCXXeM2AsFdg+LJqpOJApFA=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Riyadh

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database — XAMPP MariaDB / MySQL (native on port 3306)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=diyar
DB_USERNAME=root
DB_PASSWORD=

# Session, Cache, Queue — Native Drivers (No Docker / Redis required)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@diyar.sa"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend URLs for CORS / Sanctum
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000,localhost:5173,127.0.0.1:5173

# DIYAR API metadata
DIYAR_API_VERSION=1.0.0-stage26
DIYAR_STAGE="Stage 26 — V1.1"

# Rate Limits
DIYAR_AUTH_RATE_LIMIT=120
DIYAR_OTP_RATE_LIMIT=60
DIYAR_CATALOG_SEARCH_RATE_LIMIT=300
DIYAR_CATALOG_SEARCH_SUGGESTIONS_RATE_LIMIT=300
DIYAR_WEBHOOKS_RATE_LIMIT=300
DIYAR_LOGIN_MAX_ATTEMPTS=20
DIYAR_LOGIN_DECAY_MINUTES=5

# Demo password & fake payments
DIYAR_DEMO_PASSWORD=Password123!
DIYAR_PAYMENT_GATEWAY=myfatoorah
DIYAR_PAYMENT_CURRENCY=SAR
DIYAR_PAYMENT_SESSION_EXPIRY_MINUTES=10
DIYAR_PAYMENT_USE_FAKE_GATEWAY=true

DIYAR_MAIL_ENABLED=false
DIYAR_MAIL_FAIL_SILENTLY=true

# Reverb (optional local realtime)
REVERB_APP_ID=diyar-local
REVERB_APP_KEY=diyar_local_reverb_key
REVERB_APP_SECRET=diyar-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8000
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
