# DIYAR — Staging environment template
# Copy to .env on the staging host. NEVER reuse production secrets.

APP_NAME="[STAGING] DIYAR"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging-api.diyar.sa
APP_TIMEZONE=Asia/Riyadh

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=diyar_staging
DB_USERNAME=diyar_staging
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=.diyar.sa

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=diyar-staging-

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@staging.diyar.sa"
MAIL_FROM_NAME="[STAGING] DIYAR"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=me-south-1
AWS_BUCKET=diyar-staging-media

FRONTEND_URL=https://staging.diyar.sa
SANCTUM_STATEFUL_DOMAINS=staging.diyar.sa,staging-admin.diyar.sa

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=diyar-staging
REVERB_APP_KEY=diyar-staging-key
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8090
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=https://staging.diyar.sa,https://staging-admin.diyar.sa
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8090

DIYAR_API_VERSION=1.0.0-staging
DIYAR_STAGE="Staging"

# Payments — sandbox only
DIYAR_PAYMENT_USE_FAKE_GATEWAY=false
MYFATOORAH_TEST_MODE=true
MYFATOORAH_API_KEY=
MYFATOORAH_WEBHOOK_SECRET_KEY=

# SMS — test credentials or disabled sink
MSEGAT_USERNAME=
MSEGAT_API_KEY=

DIYAR_ENFORCE_REDIS_IN_PRODUCTION=true

# Demo seed password for staging QA accounts only
DIYAR_DEMO_PASSWORD=StagingPassword123!

# Staging QA — fixed OTP (123456) + logs plain code in Render logs. NEVER set in production.
DIYAR_OTP_TEST_CODE=123456
