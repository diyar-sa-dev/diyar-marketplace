APP_NAME=DIYAR
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=diyar_loadtest
DB_USERNAME=root
DB_PASSWORD=loadtest

CACHE_STORE=redis
QUEUE_CONNECTION=sync
SESSION_DRIVER=redis
SESSION_CONNECTION=default

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PREFIX=diyar-loadtest-

DIYAR_LOADTEST_MODE=true
DIYAR_HEALTH_PROBE_CACHE_SECONDS=5
DIYAR_PAYMENT_USE_FAKE_GATEWAY=true
DIYAR_ENFORCE_REDIS_IN_PRODUCTION=false

LOG_CHANNEL=stderr
LOG_LEVEL=warning
