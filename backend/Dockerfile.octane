FROM php:8.3-cli-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    unzip \
    pkg-config \
    libzip-dev \
    libicu-dev \
    libsqlite3-dev \
    libbrotli-dev \
    libssl-dev \
    zlib1g-dev \
    && docker-php-ext-install pdo_mysql pdo_pgsql pdo_sqlite zip intl pcntl \
    && pecl install redis swoole \
    && docker-php-ext-enable redis swoole \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

COPY . .

# storage/logs is .dockerignore'd — Octane needs it for octane-server-state.json
RUN mkdir -p storage/logs storage/framework/cache/data storage/framework/sessions storage/framework/views bootstrap/cache \
    && chmod -R 777 storage bootstrap/cache

# Avoid booting Laravel during image build (no Redis yet; APP_ENV may be production in copied .env).
ENV APP_ENV=local \
    DIYAR_ENFORCE_REDIS_IN_PRODUCTION=false \
    CACHE_STORE=array \
    QUEUE_CONNECTION=sync

RUN composer install --no-interaction --prefer-dist --optimize-autoloader --ignore-platform-reqs --no-scripts

EXPOSE 8000

CMD ["php", "artisan", "octane:start", "--server=swoole", "--host=0.0.0.0", "--port=8000", "--workers=4", "--task-workers=2", "--max-requests=1000"]
