FROM diyar-kvm2-test-app:latest

WORKDIR /var/www/html

COPY . .

# storage/logs is .dockerignore'd — Octane needs it for octane-server-state.json
RUN mkdir -p storage/logs storage/framework/cache/data storage/framework/sessions storage/framework/views bootstrap/cache \
    && chmod -R 777 storage bootstrap/cache

# Avoid booting Laravel during image build (no Redis yet; APP_ENV may be production in copied .env).
ENV APP_ENV=local \
    DIYAR_ENFORCE_REDIS_IN_PRODUCTION=false \
    CACHE_STORE=array \
    QUEUE_CONNECTION=sync

RUN composer dump-autoload --optimize \
    && php -r "if (!extension_loaded('bcmath') || !extension_loaded('swoole')) { fwrite(STDERR, 'required extensions missing\n'); exit(1); }"

EXPOSE 8000

CMD ["php", "artisan", "octane:start", "--server=swoole", "--host=0.0.0.0", "--port=8000", "--workers=2", "--task-workers=1", "--max-requests=500"]
