# DIYAR Marketplace — monorepo editor standards
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,jsx,ts,tsx,json,css,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[backend/**]
indent_style = space
indent_size = 4

[backend/composer.json]
indent_size = 4

[backend/composer.lock]
indent_size = 4

[*.php]
indent_style = space
indent_size = 4
